{
  "name": "alethialabs",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:console": "turbo run dev --filter=console",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:logs": "touch /tmp/alethia-dev-console.log && tail -n +1 -f /tmp/alethia-dev-console.log",
    "dev:stripe-logs": "touch /tmp/alethia-stripe.log && tail -n +1 -f /tmp/alethia-stripe.log",
    "dev:doctor": "bash scripts/dev-doctor.sh",
    "dev:runner": "bash scripts/dev-runner.sh",
    "dev:runner:logs": "bash scripts/dev-runner-logs.sh",
    "dev:runner:down": "bash scripts/dev-runner-down.sh",
    "codex:doctor": "bash scripts/codex-harness.sh doctor",
    "codex:self-test": "bash scripts/codex-harness.sh self-test",
    "dev:stack": "bash scripts/dev-stack.sh",
    "dev:stack:logs": "docker compose -f docker-compose.dev.yml logs -f --tail=120",
    "dev:stack:down": "docker compose -f docker-compose.dev.yml down --remove-orphans; rm -rf /tmp/alethia-dev-stack.lock",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:up": "bash scripts/db-bootstrap.sh",
    "db:reset": "docker compose down -v && bash scripts/db-bootstrap.sh",
    "compose:up": "bash scripts/compose-up.sh",
    "compose:up:full": "bash scripts/compose-up.sh caddy app docs blog runner",
    "compose:up:site": "COMPOSE_PROFILES=marketing bash scripts/compose-up.sh caddy app docs blog marketing",
    "compose:ps": "docker compose ps",
    "compose:logs": "docker compose logs -f --tail=100",
    "compose:down": "docker compose down",
    "check:connector-assets": "node scripts/check-connector-assets.mjs",
    "check:docs-contract": "node scripts/check-docs-contract.mjs",
    "check:addon-render": "bash scripts/addons/check-render-determinism.sh",
    "check:addon-published-defaults": "bash scripts/addons/check-published-defaults.sh",
    "check:addon-resource-fit": "bash scripts/addons/check-resource-fit.sh",
    "check:shared-surface": "node scripts/check-shared-surface.mjs",
    "gen:shared-surface": "node scripts/check-shared-surface.mjs --write",
    "check:console-routes": "node scripts/lib/console-routes.mjs --summary",
    "check:route-states": "node scripts/check-route-states.mjs",
    "check:filter-standard": "node scripts/check-filter-standard.mjs",
    "check:ramp-transcription": "node scripts/check-ramp-transcription.mjs",
    "check:one-board": "node scripts/check-one-board.mjs",
    "check:theme-inline": "node scripts/check-theme-inline-overrides.mjs",
    "check:ui-client-boundary": "node scripts/check-ui-client-boundary.mjs",
    "check:workflow-shape": "node scripts/ci/check-workflow-shape.mjs",
    "check:required-checks": "node scripts/ci/check-required-checks.mjs",
    "check:pnpm-script-refs": "node scripts/ci/check-pnpm-script-refs.mjs",
    "check:coverage-exclusions": "node scripts/check-coverage-exclusions.mjs",
    "check:floors-reproducible": "node scripts/check-floors-reproducible.mjs",
    "check:var-utility-shadowing": "node scripts/check-var-utility-shadowing.mjs",
    "check:legal-hashes": "node scripts/check-legal-document-hashes.mjs",
    "check:e2e-knob-reach": "node scripts/check-e2e-knob-reach.mjs",
    "check:e2e-spend-guard": "node scripts/check-e2e-spend-guard.mjs",
    "check:hetzner-lb-location": "node scripts/check-hetzner-lb-location.mjs",
    "check:hetzner-image-cache": "node scripts/check-hetzner-image-cache.mjs",
    "check:tfvars-safety": "node scripts/check-tfvars-safety.mjs",
    "check:templates-refresh-safe": "node scripts/check-templates-refresh-safe.mjs",
    "check:open-core": "node scripts/check-open-core-boundary.mjs",
    "legal:check-ip-activation": "node scripts/legal/activate-company-ip.mjs --check-markers",
    "legal:check-cla-gate": "node scripts/legal/cla-check-selftest.mjs",
    "legal:check-cla-hashes": "node scripts/legal/check-cla-hashes.mjs",
    "legal:activate-ip": "node scripts/legal/activate-company-ip.mjs",
    "check:programme": "node scripts/programme-rollup.mjs",
    "gen:programme": "node scripts/programme-rollup.mjs --write",
		"check:runner-self-image": "node scripts/check-runner-self-image.mjs",
    "compliance:licenses": "node scripts/license-inventory.mjs",
    "compliance:release": "node scripts/release-compliance.mjs",
    "source:community": "bash scripts/create-community-source.sh",
    "sync:connector-assets": "node scripts/sync-connector-assets.mjs",
    "env:box": "bash scripts/env.sh box",
    "env:up": "bash scripts/env.sh up",
    "env:push": "bash scripts/env.sh push",
    "env:down": "bash scripts/env.sh down",
    "env:status": "bash scripts/env.sh status",
    "env:verify": "bash scripts/env.sh verify",
    "env:logs": "bash scripts/env.sh logs",
    "env:open": "bash scripts/env.sh open",
    "env:ssh": "bash scripts/env.sh ssh",
    "env:check": "bash scripts/env.sh check",
    "env:test": "bash scripts/env.sh test",
    "env:runner": "bash scripts/env.sh runner",
    "env:reap": "bash scripts/env.sh reap",
    "env:timer": "bash scripts/env.sh timer",
    "wt": "bash scripts/worktree.sh",
    "wt:ls": "git worktree list",
    "wt:prune": "bash scripts/worktree.sh --prune",
    "wt:who": "bash scripts/worktree.sh --who",
    "wt:rm": "bash scripts/worktree.sh --remove",
    "wt:release": "bash scripts/worktree.sh --release",
    "wt:steal": "bash scripts/worktree.sh --steal",
    "branch:prune": "bash scripts/branch-prune.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@alicloud/credentials": "2.4.7",
      "@ai-sdk/provider": "3.0.13",
      "@ai-sdk/provider-utils": "4.0.37",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "19.2.8",
      "@types/react-dom": "19.2.3",
      "zod": "4.4.3",
      "kysely": "0.29.4"
    }
  }
}
