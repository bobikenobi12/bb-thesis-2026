{
	"components": {
		"databases": [
			{
				"name": "appdb",
				"engine_family": "postgres",
				"engine_version": "16"
			}
		],
		"caches": [
			{
				"name": "sessions",
				"num_cache_nodes": 2
			}
		],
		"queues": [
			{
				"name": "jobs"
			}
		],
		"registries": [
			{
				"name": "app-images"
			}
		],
		"secrets": [
			{
				"name": "api-key"
			}
		],
		"nosqlTables": [
			{
				"name": "items"
			}
		],
		"topics": [
			{
				"name": "events"
			}
		]
	},
	"addons": [
		{
			"id": "secrets-vault",
			"mode": "managed",
			"chartRepo": "https://helm.releases.hashicorp.com",
			"chart": "vault",
			"version": "0.28.1",
			"namespace": "secrets",
			"values": {
				"injector": {
					"enabled": false
				},
				"ui": {
					"enabled": false
				},
				"server": {
					"standalone": {
						"enabled": true
					},
					"ha": {
						"enabled": false
					},
					"dataStorage": {
						"enabled": true,
						"size": "10Gi",
						"storageClass": "hcloud-volumes"
					},
					"auditStorage": {
						"enabled": true,
						"size": "10Gi",
						"storageClass": "hcloud-volumes"
					}
				}
			},
			"syncWave": 0
		},
		{
			"id": "cnpg-operator",
			"mode": "managed",
			"chartRepo": "https://cloudnative-pg.github.io/charts",
			"chart": "cloudnative-pg",
			"version": "0.22.1",
			"namespace": "cnpg-system",
			"values": {},
			"syncWave": 0,
			"crds": [
				"clusters.postgresql.cnpg.io"
			]
		},
		{
			"id": "db-appdb",
			"mode": "managed",
			"chartRepo": "https://cloudnative-pg.github.io/charts",
			"chart": "cluster",
			"version": "0.0.11",
			"namespace": "databases",
			"values": {
				"cluster": {
					"instances": 1,
					"storage": {
						"size": "10Gi",
						"storageClass": "hcloud-volumes"
					},
					"imageName": "ghcr.io/cloudnative-pg/postgresql:16"
				}
			},
			"syncWave": 1
		},
		{
			"id": "topic-events",
			"mode": "managed",
			"chartRepo": "https://nats-io.github.io/k8s/helm/charts/",
			"chart": "nats",
			"version": "2.14.6",
			"namespace": "topics",
			"values": {
				"config": {
					"jetstream": {
						"enabled": true,
						"fileStore": {
							"enabled": true,
							"pvc": {
								"enabled": true,
								"size": "10Gi",
								"storageClassName": "hcloud-volumes"
							}
						}
					}
				}
			},
			"syncWave": 1
		},
		{
			"id": "scylla-operator",
			"mode": "managed",
			"chartRepo": "https://scylla-operator-charts.storage.googleapis.com/stable",
			"chart": "scylla-operator",
			"version": "v1.21.1",
			"namespace": "scylla-operator",
			"values": {},
			"syncWave": 0,
			"crds": [
				"scyllaclusters.scylla.scylladb.com"
			],
			"requiresCertManager": true
		},
		{
			"id": "nosql-items",
			"mode": "managed",
			"chartRepo": "https://scylla-operator-charts.storage.googleapis.com/stable",
			"chart": "scylla",
			"version": "v1.21.1",
			"namespace": "nosql",
			"values": {
				"alternator": {
					"enabled": true,
					"insecureEnableHTTP": true,
					"writeIsolation": "always"
				},
				"developerMode": true,
				"cpuset": false,
				"datacenter": "hetzner",
				"racks": [
					{
						"name": "rack-1",
						"members": 1,
						"storage": {
							"storageClassName": "hcloud-volumes",
							"capacity": "10Gi"
						},
						"resources": {
							"limits": {
								"cpu": 1,
								"memory": "2Gi"
							},
							"requests": {
								"cpu": "500m",
								"memory": "1Gi"
							}
						},
						"placement": {}
					}
				]
			},
			"syncWave": 1
		},
		{
			"id": "cache-sessions",
			"mode": "managed",
			"chartRepo": "https://valkey-io.github.io/valkey-helm",
			"chart": "valkey",
			"version": "0.10.0",
			"namespace": "caches",
			"values": {
				"dataStorage": {
					"enabled": true,
					"requestedSize": "8Gi",
					"className": "hcloud-volumes"
				},
				"replica": {
					"enabled": true,
					"replicas": 1,
					"persistence": {
						"size": "8Gi",
						"storageClass": "hcloud-volumes"
					}
				}
			},
			"syncWave": 1
		},
		{
			"id": "registry-app-images",
			"mode": "managed",
			"chartRepo": "https://helm.goharbor.io",
			"chart": "harbor",
			"version": "1.15.1",
			"namespace": "registries",
			"values": {
				"existingSecretAdminPassword": "harbor-app-images-admin",
				"existingSecretAdminPasswordKey": "HARBOR_ADMIN_PASSWORD",
				"existingSecretSecretKey": "harbor-app-images-admin",
				"core": {
					"existingSecret": "harbor-app-images-admin",
					"existingXsrfSecret": "harbor-app-images-admin",
					"existingXsrfSecretKey": "CSRF_KEY",
					"secretName": "harbor-app-images-admin"
				},
				"jobservice": {
					"existingSecret": "harbor-app-images-admin",
					"existingSecretKey": "JOBSERVICE_SECRET"
				},
				"registry": {
					"existingSecret": "harbor-app-images-admin",
					"existingSecretKey": "REGISTRY_HTTP_SECRET",
					"credentials": {
						"existingSecret": "harbor-app-images-admin",
						"username": "harbor_registry_user"
					}
				},
				"expose": {
					"type": "clusterIP",
					"tls": {
						"enabled": false
					},
					"clusterIP": {
						"name": "registry-app-images"
					}
				},
				"externalURL": "http://registry-app-images.registries.svc.cluster.local",
				"updateStrategy": {
					"type": "Recreate"
				},
				"persistence": {
					"persistentVolumeClaim": {
						"registry": {
							"size": "50Gi",
							"storageClass": "hcloud-volumes"
						},
						"jobservice": {
							"jobLog": {
								"size": "10Gi",
								"storageClass": "hcloud-volumes"
							}
						},
						"database": {
							"size": "10Gi",
							"storageClass": "hcloud-volumes"
						},
						"redis": {
							"size": "10Gi",
							"storageClass": "hcloud-volumes"
						},
						"trivy": {
							"size": "10Gi",
							"storageClass": "hcloud-volumes"
						}
					}
				}
			},
			"syncWave": 2
		},
		{
			"id": "queue-jobs",
			"mode": "managed",
			"chartRepo": "https://cloudpirates-io.github.io/helm-charts",
			"chart": "rabbitmq",
			"version": "0.21.9",
			"namespace": "queues",
			"values": {
				"replicaCount": 1,
				"auth": {
					"existingSecret": "rabbitmq-jobs-credentials",
					"existingPasswordKey": "password",
					"existingErlangCookieKey": "erlang-cookie",
					"username": "admin"
				},
				"persistence": {
					"enabled": true,
					"size": "8Gi",
					"storageClass": "hcloud-volumes"
				}
			},
			"syncWave": 1
		}
	],
	"chartedNotOffered": []
}
