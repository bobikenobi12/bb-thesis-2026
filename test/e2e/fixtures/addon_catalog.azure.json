[
	{
		"id": "argo-rollouts",
		"mode": "managed",
		"chartRepo": "https://argoproj.github.io/argo-helm",
		"chart": "argo-rollouts",
		"version": "2.37.7",
		"namespace": "argo-rollouts",
		"values": {
			"controller": {
				"replicas": 2
			},
			"dashboard": {
				"enabled": false
			}
		},
		"syncWave": 2
	},
	{
		"id": "external-dns",
		"mode": "managed",
		"chartRepo": "https://kubernetes-sigs.github.io/external-dns/",
		"chart": "external-dns",
		"version": "1.15.0",
		"namespace": "external-dns",
		"values": {
			"provider": {
				"name": "azure"
			},
			"domainFilters": [
				"addon-e2e.invalid"
			],
			"serviceAccount": {
				"name": "addon-external-dns",
				"annotations": {
					"azure.workload.identity/client-id": "alethia-infra:external-dns-workload-identity"
				}
			},
			"podLabels": {
				"azure.workload.identity/use": "true"
			},
			"extraVolumes": [
				{
					"name": "azure-config",
					"secret": {
						"secretName": "alethia-addon-external-dns",
						"items": [
							{
								"key": "azure.json",
								"path": "azure.json"
							}
						]
					}
				}
			],
			"extraVolumeMounts": [
				{
					"name": "azure-config",
					"mountPath": "/etc/kubernetes",
					"readOnly": true
				}
			]
		},
		"syncWave": 2,
		"secretRef": {
			"secretName": "alethia-addon-external-dns",
			"namespace": "external-dns",
			"keys": [],
			"staticData": {
				"azure.json": "{\n  \"cloud\": \"AzurePublicCloud\",\n  \"tenantId\": \"00000000-0000-0000-0000-000000000000\",\n  \"subscriptionId\": \"00000000-0000-0000-0000-000000000000\",\n  \"resourceGroup\": \"example-dns-rg\",\n  \"useWorkloadIdentityExtension\": true\n}\n"
			}
		}
	},
	{
		"id": "falco",
		"mode": "managed",
		"chartRepo": "https://falcosecurity.github.io/charts",
		"chart": "falco",
		"version": "9.1.0",
		"namespace": "falco",
		"values": {
			"driver": {
				"kind": "auto"
			},
			"falco": {
				"json_output": false
			},
			"falcosidekick": {
				"enabled": false
			}
		},
		"syncWave": 2,
		"podSecurity": "privileged"
	},
	{
		"id": "goldilocks",
		"mode": "managed",
		"chartRepo": "https://charts.fairwinds.com/stable",
		"chart": "goldilocks",
		"version": "9.0.0",
		"namespace": "goldilocks",
		"values": {
			"vpa": {
				"enabled": false
			},
			"dashboard": {
				"replicaCount": 2
			}
		},
		"syncWave": 4
	},
	{
		"id": "harbor",
		"mode": "managed",
		"chartRepo": "https://helm.goharbor.io",
		"chart": "harbor",
		"version": "1.15.1",
		"namespace": "harbor",
		"values": {
			"updateStrategy": {
				"type": "Recreate"
			},
			"persistence": {
				"persistentVolumeClaim": {
					"registry": {
						"size": "50Gi"
					}
				}
			},
			"expose": {
				"type": "clusterIP",
				"tls": {
					"enabled": false
				}
			},
			"existingSecretAdminPassword": "alethia-addon-harbor",
			"existingSecretAdminPasswordKey": "adminPassword",
			"existingSecretSecretKey": "alethia-addon-harbor",
			"core": {
				"existingSecret": "alethia-addon-harbor",
				"existingXsrfSecret": "alethia-addon-harbor",
				"existingXsrfSecretKey": "CSRF_KEY",
				"secretName": "alethia-addon-harbor"
			},
			"jobservice": {
				"existingSecret": "alethia-addon-harbor",
				"existingSecretKey": "JOBSERVICE_SECRET"
			},
			"registry": {
				"existingSecret": "alethia-addon-harbor",
				"existingSecretKey": "REGISTRY_HTTP_SECRET",
				"credentials": {
					"existingSecret": "alethia-addon-harbor"
				}
			}
		},
		"syncWave": 2,
		"secretRef": {
			"secretName": "alethia-addon-harbor",
			"namespace": "harbor",
			"keys": [
				"adminPassword",
				"secretKey",
				"secret",
				"CSRF_KEY",
				"JOBSERVICE_SECRET",
				"REGISTRY_HTTP_SECRET",
				"REGISTRY_PASSWD",
				"REGISTRY_HTPASSWD",
				"tls.key"
			]
		}
	},
	{
		"id": "ingress-nginx",
		"mode": "managed",
		"chartRepo": "https://kubernetes.github.io/ingress-nginx",
		"chart": "ingress-nginx",
		"version": "4.11.2",
		"namespace": "ingress-nginx",
		"values": {
			"controller": {
				"replicaCount": 1,
				"service": {
					"type": "LoadBalancer"
				},
				"metrics": {
					"enabled": false
				}
			}
		},
		"syncWave": 1
	},
	{
		"id": "keda",
		"mode": "managed",
		"chartRepo": "https://kedacore.github.io/charts",
		"chart": "keda",
		"version": "2.15.1",
		"namespace": "keda",
		"values": {
			"operator": {
				"replicaCount": 1
			}
		},
		"syncWave": 2
	},
	{
		"id": "kube-prometheus-stack",
		"mode": "managed",
		"chartRepo": "https://prometheus-community.github.io/helm-charts",
		"chart": "kube-prometheus-stack",
		"version": "61.9.0",
		"namespace": "monitoring",
		"values": {
			"grafana": {
				"enabled": true,
				"admin": {
					"existingSecret": "alethia-addon-kube-prometheus-stack",
					"userKey": "adminUser",
					"passwordKey": "adminPassword"
				}
			},
			"prometheus": {
				"prometheusSpec": {
					"retention": "15d",
					"scrapeInterval": "30s",
					"storageSpec": {
						"volumeClaimTemplate": {
							"spec": {
								"resources": {
									"requests": {
										"storage": "20Gi"
									}
								}
							}
						}
					}
				}
			},
			"prometheusOperator": {
				"admissionWebhooks": {
					"enabled": false
				},
				"tls": {
					"enabled": false
				}
			},
			"alertmanager": {
				"enabled": true
			}
		},
		"syncWave": 2,
		"podSecurity": "privileged",
		"secretRef": {
			"secretName": "alethia-addon-kube-prometheus-stack",
			"namespace": "monitoring",
			"keys": [
				"adminPassword"
			],
			"staticData": {
				"adminUser": "admin"
			}
		}
	},
	{
		"id": "kyverno",
		"mode": "managed",
		"chartRepo": "https://kyverno.github.io/kyverno/",
		"chart": "kyverno",
		"version": "3.2.6",
		"namespace": "kyverno",
		"values": {
			"admissionController": {
				"replicas": 3
			},
			"backgroundController": {
				"enabled": true
			}
		},
		"syncWave": 1
	},
	{
		"id": "loki",
		"mode": "managed",
		"chartRepo": "https://grafana.github.io/helm-charts",
		"chart": "loki",
		"version": "6.6.0",
		"namespace": "monitoring",
		"values": {
			"deploymentMode": "SingleBinary",
			"loki": {
				"commonConfig": {
					"replication_factor": 1
				},
				"storage": {
					"type": "filesystem"
				},
				"schemaConfig": {
					"configs": [
						{
							"from": "2024-01-01",
							"store": "tsdb",
							"object_store": "filesystem",
							"schema": "v13",
							"index": {
								"prefix": "index_",
								"period": "24h"
							}
						}
					]
				},
				"limits_config": {
					"retention_period": "336h"
				}
			},
			"read": {
				"replicas": 0
			},
			"write": {
				"replicas": 0
			},
			"backend": {
				"replicas": 0
			},
			"chunksCache": {
				"allocatedMemory": 1024
			},
			"singleBinary": {
				"persistence": {
					"size": "10Gi"
				}
			}
		},
		"syncWave": 3
	},
	{
		"id": "minio",
		"mode": "managed",
		"chartRepo": "https://charts.min.io/",
		"chart": "minio",
		"version": "5.2.0",
		"namespace": "minio",
		"values": {
			"mode": "standalone",
			"resources": {
				"requests": {
					"memory": "512Mi"
				}
			},
			"persistence": {
				"size": "50Gi"
			},
			"existingSecret": "alethia-addon-minio"
		},
		"syncWave": 2,
		"secretRef": {
			"secretName": "alethia-addon-minio",
			"namespace": "minio",
			"keys": [
				"rootPassword"
			],
			"staticData": {
				"rootUser": "admin"
			}
		}
	},
	{
		"id": "opentelemetry-collector",
		"mode": "managed",
		"chartRepo": "https://open-telemetry.github.io/opentelemetry-helm-charts",
		"chart": "opentelemetry-collector",
		"version": "0.108.0",
		"namespace": "observability",
		"values": {
			"mode": "deployment",
			"image": {
				"repository": "otel/opentelemetry-collector-contrib"
			},
			"config": {
				"receivers": {
					"otlp": {
						"protocols": {
							"grpc": {},
							"http": {}
						}
					}
				},
				"exporters": {
					"debug": {}
				},
				"service": {
					"pipelines": {
						"traces": {
							"receivers": [
								"otlp"
							],
							"exporters": [
								"debug"
							]
						},
						"metrics": {
							"receivers": [
								"otlp"
							],
							"exporters": [
								"debug"
							]
						},
						"logs": {
							"receivers": [
								"otlp"
							],
							"exporters": [
								"debug"
							]
						}
					}
				}
			},
			"replicaCount": 1
		},
		"syncWave": 3
	},
	{
		"id": "reloader",
		"mode": "managed",
		"chartRepo": "https://stakater.github.io/stakater-charts",
		"chart": "reloader",
		"version": "1.1.0",
		"namespace": "reloader",
		"values": {
			"reloader": {
				"watchGlobally": true,
				"deployment": {
					"replicas": 1
				}
			}
		},
		"syncWave": 1
	},
	{
		"id": "sealed-secrets",
		"mode": "managed",
		"chartRepo": "https://bitnami.github.io/sealed-secrets",
		"chart": "sealed-secrets",
		"version": "2.16.1",
		"namespace": "kube-system",
		"values": {
			"keyrenewperiod": "720h"
		},
		"syncWave": 1
	},
	{
		"id": "tempo",
		"mode": "managed",
		"chartRepo": "https://grafana.github.io/helm-charts",
		"chart": "tempo",
		"version": "1.10.3",
		"namespace": "monitoring",
		"values": {
			"tempo": {
				"retention": "24h"
			},
			"persistence": {
				"enabled": true,
				"size": "10Gi"
			}
		},
		"syncWave": 3
	},
	{
		"id": "trivy-operator",
		"mode": "managed",
		"chartRepo": "https://aquasecurity.github.io/helm-charts/",
		"chart": "trivy-operator",
		"version": "0.24.1",
		"namespace": "trivy-system",
		"values": {
			"trivy": {
				"ignoreUnfixed": true
			}
		},
		"syncWave": 2
	},
	{
		"id": "vault",
		"mode": "managed",
		"chartRepo": "https://helm.releases.hashicorp.com",
		"chart": "vault",
		"version": "0.28.1",
		"namespace": "vault",
		"values": {
			"server": {
				"ha": {
					"enabled": false
				}
			},
			"ui": {
				"enabled": true
			},
			"injector": {
				"enabled": false
			}
		},
		"syncWave": 2,
		"bootstrap": {
			"kind": "vault-init",
			"apiBase": "http://addon-vault.vault.svc.cluster.local:8200",
			"stateSecret": "alethia-vault-addon-state"
		}
	},
	{
		"id": "velero",
		"mode": "managed",
		"chartRepo": "https://vmware-tanzu.github.io/helm-charts",
		"chart": "velero",
		"version": "7.2.1",
		"namespace": "velero",
		"values": {
			"upgradeCRDs": false,
			"initContainers": [
				{
					"name": "velero-plugin",
					"image": "velero/velero-plugin-for-aws:v1.10.1",
					"imagePullPolicy": "IfNotPresent",
					"volumeMounts": [
						{
							"mountPath": "/target",
							"name": "plugins"
						}
					]
				}
			],
			"snapshotsEnabled": false,
			"deployNodeAgent": false,
			"configuration": {
				"backupStorageLocation": [],
				"volumeSnapshotLocation": []
			}
		},
		"syncWave": 3
	}
]
